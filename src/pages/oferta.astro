---
import Layout from '../layouts/Layout.astro';
import Crumbs from '../components/Crumbs.astro';
import legal from '../data/legal.json';
import { CMS } from '../data/products';
const doc = CMS?.documents?.find((d: any) => d.slug === 'oferta');
const paras: string[] = doc ? doc.body.split(/\n\s*\n/).map((t: string) => t.trim()).filter(Boolean) : null as any;
const P = legal.oferta.slice(1);
---
<Layout title="Договор оферты — Агатэк">
<section data-name="Документ"><div class="wrap"><Crumbs items={[['Договор оферты']]} /><article class="doc"><h1>Договор оферты</h1>{(paras ?? P).map((t: string) => t.startsWith('## ') ? <h2>{t.slice(3)}</h2> : !paras && /^\d+\.\s/.test(t) && t.length < 80 ? <h2>{t}</h2> : <p>{t}</p>)}</article></div></section>
</Layout>
